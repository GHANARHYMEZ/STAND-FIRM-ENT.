{
  "name": "stand-firm-ent",
  "productName": "STAND FIRM ENT.",
  "version": "1.0.0",
  "description": "STAND FIRM ENT. shop manager: Android, Windows and installable web app from one codebase.",
  "author": "STAND FIRM ENT.",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "build:web": "node scripts/build-web.js",
    "serve:web": "npm run build:web && http-server www -p 8080 -c-1",
    "electron:dev": "npm run build:web && electron .",
    "build:win": "npm run build:web && electron-builder --win --x64 --publish never",
    "android:setup": "node scripts/android.js setup",
    "android:build": "node scripts/android.js build",
    "icons": "python3 scripts/make-icons.py"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0",
    "@fontsource-variable/bricolage-grotesque": "^5.1.0",
    "@fontsource/figtree": "^5.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "http-server": "^14.1.1"
  },
  "build": {
    "appId": "com.standfirment.shop",
    "productName": "STAND FIRM ENT",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["electron/**", "www/**", "package.json"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico",
      "artifactName": "StandFirmENT-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "STAND FIRM ENT"
    }
  }
}
